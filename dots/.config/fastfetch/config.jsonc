{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "title",
      "keyWidth": 10
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow",
      "timeout": 5
    },
    {
      "type": "kernel",
      "key": "├ Kernel",
      "keyColor": "yellow",
      "timeout": 5
    },
    {
      "type": "packages",
      "key": "├󰏖 Packages",
      "keyColor": "yellow",
      "timeout": 5
    },
    {
      "type": "shell",
      "key": "├ Shell",
      "keyColor": "yellow",
      "timeout": 5
    },
    {
      "type": "localIP",
      "key": "├󰩟 Local IP",
      "keyColor": "yellow",
      "timeout": 5
    },
    {
      "type": "publicIP",
      "key": "├󰩟 Public IP",
      "keyColor": "yellow",
      "timeout": 5
    },
    {
      "type": "uptime",
      "key": "└󰅐 Start Time",
      "keyColor": "yellow",
      "timeout": 5
    },
    "break",
    {
      "type": "custom",
      "key": " DE",
      "keyColor": "blue",
      "timeout": 5
    },
    {
      "type": "wm",
      "key": "├󰧨 Window Manager",
      "keyColor": "blue",
      "timeout": 5
    },
    {
      "type": "lm",
      "key": "├󰧨 Login Manager",
      "keyColor": "blue",
      "timeout": 5
    },
    {
      "type": "wmtheme",
      "key": "├󰉼 WM Theme",
      "keyColor": "blue",
      "timeout": 5
    },
    {
      "type": "theme",
      "key": "├󰉼 Color Themes",
      "keyColor": "blue",
      "timeout": 5
    },
    {
      "type": "icons",
      "key": "├󰸉 System Icons",
      "keyColor": "blue",
      "timeout": 5
    },
    {
      "type": "font",
      "key": "├ System Fonts",
      "keyColor": "blue",
      "timeout": 5
    },
    {
      "type": "terminal",
      "key": "└ Terminal",
      "keyColor": "blue",
      "timeout": 5
    },
    "break",
    {
      "type": "chassis",
      "key": "󰌢 PC",
      "keyColor": "green",
      "timeout": 5
    },
    {
      "type": "board",
      "key": "├ Board",
      "keyColor": "green",
      "timeout": 5
    },
    {
      "type": "cpu",
      "key": "├󰻠 CPU",
      "keyColor": "green",
      "temp": true,
      "freqNdigits": 1,
      "timeout": 5
    },
    {
      "type": "memory",
      "key": "├󰑭 RAM",
      "keyColor": "green",
      "timeout": 5
    },
    {
      "type": "swap",
      "key": "├󰓡 Zram",
      "keyColor": "green",
      "timeout": 5
    },
    {
      "type": "disk",
      "key": "├ Disk",
      "keyColor": "green",
      "timeout": 5
    },
    {
      "type": "gpu",
      "key": "├󰍛 GPU",
      "keyColor": "green",
      "timeout": 5
    },
    {
      "type": "battery",
      "key": "├\uf240 Battery",
      "keyColor": "green",
      "temp": true,
      "timeout": 5
    },
    {
      "type": "display",
      "key": "└󰍹 Display(s)",
      "keyColor": "green",
      "timeout": 5
    }
  ]
}
